# ============================================================
# .env.example — variable names only. Copy to .env and fill in
# REAL values locally or set these in the Render dashboard.
# NEVER commit real secrets.
# ============================================================

# Active Spring profile (prod on Render).
SPRING_PROFILES_ACTIVE=prod

# Render injects PORT automatically; 10000 is the Dockerfile default.
PORT=10000

# Database — use the Render PostgreSQL internal connection URI.
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DBNAME?sslmode=require
SPRING_DATASOURCE_USERNAME=db_user
SPRING_DATASOURCE_PASSWORD=change_me
# Keep as Postgres unless you target MySQL, then: com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Keep the Flyway Postgres migrations enabled. Set false only if pointing at MySQL.
FLYWAY_ENABLED=true

# JWT signing secret (Base64-encoded, at least 256 bits). Generate one with:
#   openssl rand -base64 64
JWT_SECRET=generate_a_long_base64_secret_here

# JWT lifetimes (milliseconds).
JWT_ACCESS_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Browser origin(s) for CORS - comma separated. Set to your deployed frontend.
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# SMTP (used by EmailService for password reset links and 2FA codes).
# Leave blank to fall back to logging the email content in dev.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change_me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Connection pool size (keep low for 512 MB RAM).
DB_POOL_SIZE=5
DB_MIN_IDLE=1

# Web server thread pools.
TOMCAT_MAX_THREADS=50
TOMCAT_ACCEPT_COUNT=50

# Where uploaded files are written (ephemeral on Render Free).
FILE_UPLOAD_DIR=/tmp/uploads

# Logging levels.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# Password reset link expiry.
PASSWORD_RESET_EXPIRATION_MINUTES=30

# Two-factor authentication (settings only; login is unchanged).
# How long an OTP stays valid, and how many digits it has.
OTP_EXPIRATION_MINUTES=10
OTP_LENGTH=6

# Base URL used to build password reset links in emails.
APP_FRONTEND_URL=http://localhost:3000

# Default admin created on first startup if none exists.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=Admin123!